# LaunchMind-AI Environment Configuration

# Database: Set this to your PostgreSQL connection string
# E.g. postgresql://postgres:postgres@localhost:5432/launchmind
# If left empty or sqlite url, it will fall back to local sqlite db: sqlite:///./launchmind.db
DATABASE_URL=sqlite:///./launchmind.db

# JWT Configuration
SECRET_KEY=supersecretkeyreplaceinproduction1234567890!@#$
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API Key (Required for AI generation features)
GEMINI_API_KEY=your_gemini_api_key_here
